# RPC endpoints
SEPOLIA_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
INK_SEPOLIA_RPC_URL=
PLASMA_RPC_URL=
ARC_RPC_URL=
TEMPO_RPC_URL=

# Deployment signer
DEPLOYER_PRIVATE_KEY=
AI_HUB_ADMIN_ADDRESS=
# Optional dedicated reward treasury; defaults to AI_HUB_ADMIN_ADDRESS/deployer.
AI_HUB_REWARD_TREASURY_ADDRESS=
# Keep false for normal development. Set true only for an intentional Base Mainnet deployment.
AI_HUB_ALLOW_MAINNET_DEPLOYMENT=false

# Drop Hunter product
# Optional GitHub API token improves rate limits for live repository discovery.
GITHUB_TOKEN=
DROP_HUNTER_GITHUB_QUERIES=incentivized testnet
DROP_HUNTER_GITHUB_MAX_RESULTS=10
DROP_HUNTER_MIN_SCORE=0
DROP_HUNTER_STORE_PATH=data/drop-hunter-projects.json
DROP_HUNTER_EVIDENCE_PATH=data/drop-hunter-evidence.json
DROP_HUNTER_REWARD_PATH=data/drop-hunter-rewards.json
DROP_HUNTER_API_PORT=8787
DROP_HUNTER_REWARD_API_PORT=8788
DROP_HUNTER_AGENT_MAX_TASKS=10
DROP_HUNTER_AGENT_AUTOSTART=false
DROP_HUNTER_AGENT_INTERVAL_MS=300000
# Optional JSON array of explicitly trusted project/docs pages.
# Example: [{"id":"project-x","name":"Project X","url":"https://docs.project.example/testnet","chainId":84532,"vm":"EVM","priority":85}]
DROP_HUNTER_OFFICIAL_PAGES_JSON=
# Optional trusted HTTPS check-in endpoints. No arbitrary task URL is executed.
# Example: [{"projectId":"project-x","url":"https://project.example/api/check-in","method":"POST","successStatus":200,"successText":"ok"}]
DROP_HUNTER_CHECKIN_TARGETS_JSON=
# Safe defaults: wallet/gas actions require approval and autonomous spend is zero.
DROP_HUNTER_MAX_AUTONOMOUS_COST_USD=0
DROP_HUNTER_ALLOW_AUTONOMOUS_GAS=false
DROP_HUNTER_ALLOW_AUTONOMOUS_WALLET=false

# AI job stack (frozen/optional; not required by the Drop Hunter product runtime)
AI_REWARD_TOKEN_ADDRESS=
AI_COMPLETION_CALLER_ADDRESS=
AI_COMPLETION_ATTESTER_ADDRESS=
AI_PAYOUT_MANAGER_ADDRESS=
AI_AGENT_ENGINE_ADDRESS=
ACTIVITY_REGISTRY_ADDRESS=
AI_COMPLETION_REPORTER_ADDRESS=

# Optional AI provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
