# RPC endpoints
SEPOLIA_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
INK_SEPOLIA_RPC_URL=
PLASMA_RPC_URL=
ARC_RPC_URL=
TEMPO_RPC_URL=

# Deployment signer
DEPLOYER_PRIVATE_KEY=
AI_HUB_ADMIN_ADDRESS=
# Optional dedicated reward treasury; defaults to AI_HUB_ADMIN_ADDRESS/deployer.
AI_HUB_REWARD_TREASURY_ADDRESS=
# Keep false for normal development. Set true only for an intentional Base Mainnet deployment.
AI_HUB_ALLOW_MAINNET_DEPLOYMENT=false

# AI job stack
# When the production token is deployed, its address is also persisted in deployments/base.json.
AI_REWARD_TOKEN_ADDRESS=
AI_COMPLETION_CALLER_ADDRESS=
AI_COMPLETION_ATTESTER_ADDRESS=
AI_PAYOUT_MANAGER_ADDRESS=
AI_AGENT_ENGINE_ADDRESS=
ACTIVITY_REGISTRY_ADDRESS=
AI_COMPLETION_REPORTER_ADDRESS=

# Optional AI provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
