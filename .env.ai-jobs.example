# AI job executor
AI_JOB_EXECUTOR=dry-run

# OpenAI-compatible provider
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=
AI_PROVIDER_SYSTEM_PROMPT=You are an AI Hub execution agent. Follow the task exactly and do not invent facts.
AI_PROVIDER_TEMPERATURE=0
AI_PROVIDER_MAX_TOKENS=512
AI_PROVIDER_TIMEOUT_MS=120000

# AI job control plane
AI_JOB_API_HOST=127.0.0.1
AI_JOB_API_PORT=8787
AI_JOB_API_TOKEN=
AI_JOB_STORE=./data/ai-jobs.json
AI_JOB_BATCH_SIZE=5
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_WORKER_INTERVAL_MS=30000
AI_JOB_SCHEDULER_STATE=./data/ai-job-scheduler.json

# Durable completion publication state
AI_JOB_COMPLETION_STORE=./data/ai-job-completions.json

# On-chain AI job runtime
AI_JOB_ONCHAIN=false
AI_JOB_RPC_URL=
AI_JOB_PRIVATE_KEY=
AI_JOB_ASSIGNMENT_PRIVATE_KEY=
AI_JOB_PAYOUT_PRIVATE_KEY=
AI_AGENT_ENGINE_ADDRESS=
AI_REWARD_TOKEN_ADDRESS=
AI_COMPLETION_REPORTER_ADDRESS=
AI_COMPLETION_CALLER_ADDRESS=
AI_COMPLETION_ATTESTER_ADDRESS=
ACTIVITY_REGISTRY_ADDRESS=
AI_ONCHAIN_BINDINGS_STORE=./data/onchain-job-bindings.json
AI_JOB_AUTO_ASSIGN=true
AI_JOB_AUTO_SETTLE_REWARD=false
AI_JOB_ACTIVITY_TYPE=AI_JOB_COMPLETED
AI_JOB_PROJECT_ID=
AI_JOB_METADATA_HASH=
AI_AGENT_ID_MAP_JSON={}
