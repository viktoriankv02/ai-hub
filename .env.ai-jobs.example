# AI job executor
AI_JOB_EXECUTOR=dry-run

# Windows: run .\scripts\setup-ai-hub-storage.ps1 to use D:\ai-hub-data.
AI_HUB_DATA_DIR=./data
AI_HUB_DEPLOYMENTS_DIR=./deployments

# OpenAI-compatible provider
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=
AI_PROVIDER_SYSTEM_PROMPT=You are an AI Hub execution agent. Follow the task exactly and do not invent facts.
AI_PROVIDER_TEMPERATURE=0
AI_PROVIDER_MAX_TOKENS=512
AI_PROVIDER_TIMEOUT_MS=120000

# AI job control plane
AI_JOB_API_HOST=127.0.0.1
AI_JOB_API_PORT=8787
AI_JOB_API_TOKEN=
AI_JOB_STORE=./data/ai-jobs.json
AI_JOB_BATCH_SIZE=5
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_WORKER_INTERVAL_MS=30000
AI_JOB_SCHEDULER_STATE=./data/ai-job-scheduler.json
AI_JOB_COMPLETION_STORE=./data/ai-job-completions.json
AI_ONCHAIN_BINDINGS_STORE=./data/onchain-job-bindings.json

# Deployment target
AI_HUB_NETWORK=baseSepolia
AI_HUB_ADMIN_ADDRESS=
AI_HUB_MAINNET_DEPLOY_CONFIRM=
AI_REWARD_TOKEN_ADDRESS=
AI_DEPLOY_TEST_REWARD_TOKEN=true
AI_COMPUTE_MINIMUM_STAKE=1000000000000000000

# Base RPC endpoints
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_EXPLORER_URL=https://sepolia.basescan.org
BASE_RPC_URL=
BASE_EXPLORER_URL=https://basescan.org

# On-chain AI job runtime
AI_JOB_ONCHAIN=false
AI_JOB_RPC_URL=
AI_JOB_PRIVATE_KEY=
AI_COMPLETION_CALLER_PRIVATE_KEY=
AI_COMPLETION_ATTESTER_PRIVATE_KEY=
AI_JOB_ASSIGNMENT_PRIVATE_KEY=
AI_JOB_PAYOUT_PRIVATE_KEY=
AI_AGENT_ENGINE_ADDRESS=
AI_COMPLETION_REPORTER_ADDRESS=
AI_COMPLETION_CALLER_ADDRESS=
AI_COMPLETION_ATTESTER_ADDRESS=
ACTIVITY_REGISTRY_ADDRESS=
AI_JOB_AUTO_ASSIGN=true
AI_JOB_AUTO_SETTLE_REWARD=false
AI_JOB_ACTIVITY_TYPE=AI_JOB_COMPLETED
AI_JOB_PROJECT_ID=AI_HUB_JOB_PIPELINE
AI_JOB_METADATA_HASH=
AI_AGENT_ID_MAP_JSON={}

# Security recommendation:
# - AI_JOB_PRIVATE_KEY funds AIAgentEngine jobs.
# - AI_COMPLETION_CALLER_PRIVATE_KEY only submits attestations to AICompletionReporter.
# - AI_COMPLETION_ATTESTER_PRIVATE_KEY only signs completion payloads.
# - AI_JOB_ASSIGNMENT_PRIVATE_KEY controls job assignment.
# - AI_JOB_PAYOUT_PRIVATE_KEY controls optional reward settlement.
# - AI_COMPUTE_MINIMUM_STAKE sets the node registration stake in reward-token base units.
