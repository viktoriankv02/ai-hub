# Multi-chain AI job runtime
AI_JOB_API_HOST=127.0.0.1
AI_JOB_API_PORT=8787
AI_JOB_API_TOKEN=
AI_JOB_STORE=./data/ai-jobs.json
AI_JOB_BATCH_SIZE=5
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_DEFAULT_CHAIN_TARGET=base-sepolia

# Preferred: one JSON array containing every enabled EVM target.
# Keep private keys in a local .env file or secret manager; never commit them.
AI_JOB_CHAIN_TARGETS_JSON=

# Optional shared defaults used by prefix-based targets.
AI_JOB_PRIVATE_KEY=
AI_JOB_ASSIGNMENT_PRIVATE_KEY=
AI_JOB_PAYOUT_PRIVATE_KEY=
AI_AGENT_ID_MAP_JSON={}
AI_JOB_AUTO_ASSIGN=1
AI_JOB_AUTO_SETTLE_REWARD=0
AI_JOB_ACTIVITY_TYPE=AI_JOB_COMPLETED
AI_JOB_PROJECT_ID=
AI_JOB_METADATA_HASH=

# Prefix-based targets. A target is enabled only when all required values exist.
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_AI_AGENT_ENGINE_ADDRESS=
BASE_SEPOLIA_AI_REWARD_TOKEN_ADDRESS=
BASE_SEPOLIA_AI_COMPLETION_REPORTER_ADDRESS=
BASE_SEPOLIA_PRIVATE_KEY=
BASE_SEPOLIA_ASSIGNMENT_PRIVATE_KEY=
BASE_SEPOLIA_PAYOUT_PRIVATE_KEY=

INK_SEPOLIA_RPC_URL=
INK_SEPOLIA_AI_AGENT_ENGINE_ADDRESS=
INK_SEPOLIA_AI_REWARD_TOKEN_ADDRESS=
INK_SEPOLIA_AI_COMPLETION_REPORTER_ADDRESS=
INK_SEPOLIA_PRIVATE_KEY=
INK_SEPOLIA_ASSIGNMENT_PRIVATE_KEY=
INK_SEPOLIA_PAYOUT_PRIVATE_KEY=

ARC_TESTNET_RPC_URL=
ARC_TESTNET_AI_AGENT_ENGINE_ADDRESS=
ARC_TESTNET_AI_REWARD_TOKEN_ADDRESS=
ARC_TESTNET_AI_COMPLETION_REPORTER_ADDRESS=
ARC_TESTNET_PRIVATE_KEY=
ARC_TESTNET_ASSIGNMENT_PRIVATE_KEY=
ARC_TESTNET_PAYOUT_PRIVATE_KEY=

TEMPO_TESTNET_RPC_URL=
TEMPO_TESTNET_AI_AGENT_ENGINE_ADDRESS=
TEMPO_TESTNET_AI_REWARD_TOKEN_ADDRESS=
TEMPO_TESTNET_AI_COMPLETION_REPORTER_ADDRESS=
TEMPO_TESTNET_PRIVATE_KEY=
TEMPO_TESTNET_ASSIGNMENT_PRIVATE_KEY=
TEMPO_TESTNET_PAYOUT_PRIVATE_KEY=

PLASMA_TESTNET_RPC_URL=
PLASMA_TESTNET_AI_AGENT_ENGINE_ADDRESS=
PLASMA_TESTNET_AI_REWARD_TOKEN_ADDRESS=
PLASMA_TESTNET_AI_COMPLETION_REPORTER_ADDRESS=
PLASMA_TESTNET_PRIVATE_KEY=
PLASMA_TESTNET_ASSIGNMENT_PRIVATE_KEY=
PLASMA_TESTNET_PAYOUT_PRIVATE_KEY=
