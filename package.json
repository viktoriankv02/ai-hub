{
  "name": "ai-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:mocha": "hardhat test mocha",
    "compile": "hardhat compile",
    "preflight": "tsx scripts/testnet-preflight.ts",
    "drop-hunter": "tsx scripts/drop-hunter-report.ts",
    "drop-hunter:once": "tsx scripts/drop-hunter-once.ts",
    "ai-jobs:plan": "tsx scripts/ai-job-plan-once.ts",
    "ai-jobs:server": "tsx scripts/ai-job-server.ts",
    "ai-jobs:smoke": "tsx scripts/ai-job-smoke.ts",
    "ai-jobs:onchain-smoke": "tsx scripts/ai-job-onchain-smoke.ts",
    "ai-jobs:status": "tsx scripts/ai-job-status.ts",
    "ai-jobs:worker": "tsx scripts/ai-job-worker.ts",
    "ai-jobs:provider-smoke": "tsx scripts/ai-provider-smoke.ts",
    "ai-jobs:compute:plan": "tsx scripts/ai-job-compute-plan-once.ts",
    "ai-completion:deploy": "hardhat run scripts/deploy-ai-completion-reporter.ts",
    "ai-runtime:deploy": "hardhat run deploy/06_deploy_ai_runtime.ts",
    "ai-runtime:configure": "hardhat run deploy/07_configure_ai_runtime.ts",
    "ai-completion:configure": "hardhat run scripts/configure-ai-completion.ts",
    "base:deploy:testnet": "$env:AI_HUB_NETWORK='baseSepolia'; hardhat run deploy/08_deploy_base_ai_stack.ts",
    "base:deploy:mainnet": "$env:AI_HUB_NETWORK='base'; hardhat run deploy/08_deploy_base_ai_stack.ts",
    "base:status": "tsx scripts/base-stack-status.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "ethers": "^6.17.0",
    "hardhat": "^3.11.1",
    "mocha": "^11.7.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2"
  }
}
