# Multi-chain AI job runtime
# Each target gets isolated on-chain binding/completion state.
# Keep private keys local; never commit real credentials.

# JSON form supports any number of EVM targets.
AI_JOB_CHAIN_TARGETS_JSON=[]

# Or configure the built-in targets individually.
# BASE_SEPOLIA_RPC_URL=
